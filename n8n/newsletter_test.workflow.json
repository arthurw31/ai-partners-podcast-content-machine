   "name": "Lire l'objet",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.5,
   "position": [
    672,
    0
   ]
  },
  {
   "parameters": {
    "jsCode": "const p = $('Paramètres du test').first().json;\nconst html = $('Lire le mail publié').first().json.html;\nconst objet = String($('Lire l'objet').first().json.objet || '').trim();\n// Lien YouTube de L'ÉPISODE : à demander à l'équipe marketing (règle d'Arthur, 15/10/2026), jamais la playlist\nconst yt = String(p.lien_youtube || '').trim();\nif (html.includes('{{lien_youtube}}') && !/^https:\\/\\/(www\\.)?(youtube\\.com\\/watch|youtu\\.be\\/)/.test(yt)) {\n  throw new Error('Renseigne « lien_youtube » dans Paramètres du test : le lien de l'épisode sur YouTube (demandé au marketing), pas la playlist.');\n}\n// pas de prénom : le même mail pour tous\nconst message = html\n  .split('{{lien_youtube}}').join(yt)\n  .split('{{lien_desinscription}}').join(p.lien_desinscription);\nreturn [{ json: { destinataire: p.destinataire, objet, message, nom_expediteur: p.nom_expediteur } }];"
   },
   "name": "Personnaliser le mail",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    896,
    0
   ]
  },
