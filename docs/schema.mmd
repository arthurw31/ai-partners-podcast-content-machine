flowchart TD
    IN(["`**Dépôt des rushs**
3 caméras + micro dans DEPOT/`"])
    IN --> FE["`**rushes**
caméras reconnues, micro synchronisé`"]
    FE --> TR["`**transcribe**
texte mot à mot et qui parle`"]
    TR --> S1
    TR --> E1
    TR --> M1
    TR --> C1
    TR --> N1

    subgraph SH["5 shorts 9:16"]
        direction TB
        S1("`**propose**
Claude propose ~10 passages`") --> S2["`**L'équipe choisit 5 passages**
(pick)`"]
        S2 --> S3["`**polish**
« euh » retirés, montage, sous-titres`"]
        S3 --> S4["`**qa + aperçus MP4**
contrôle strict, correction auto`"]
        S4 -->|à corriger| S3
        S4 -->|OK| SR("`**review**
relecteur Claude sans contexte`")
        SR -->|à corriger| S3
        SR -->|OK| S5["`**L'équipe valide les aperçus**`"]
        S5 -->|retouche| S3
        S5 -->|validé| S6["`**render 1080p et posts**
1 post LinkedIn par short`"]
        S6 --> S7["`**outro**
carte YouTube avec la miniature`"]
    end

    subgraph EP["Épisode + teaser"]
        direction TB
        E1("`**episode-plan**
dérushage par Claude`")
        E1 --> E2["`**Raccords nettoyés**
sans hésitation ni mot coupé`"]
        E2 --> E3["`**Plans façon monteur**
on voit toujours celui qui parle`"]
        E3 --> E4("`**Teaser**
script de Claude, extraits vérifiés`")
        E4 --> E5["`**Chapitres et description YouTube**`"]
        E5 --> E6["`**episode-render --proxy**
aperçu 540p`"]
        E6 --> E7["`**qa --episode**
raccords, image, volume`"]
        E7 -->|OK| ER("`**review**
relecteur Claude sans contexte`")
        ER -->|à corriger| E6
        ER -->|OK| E8["`**L'équipe valide l'aperçu**`"]
        E7 -->|à corriger| E6
        E8 -->|retouche| E6
        E8 -->|validé| E9["`**episode-render 1080p**
et contrôle final`"]
    end

    subgraph MI["Titre puis miniature"]
        direction TB
        M1("`**titles**
Claude propose 5 titres`") --> M2["`**L'équipe choisit 1 titre**
(titles --pick N)`"]
        M2 --> M3["`**thumbnail**
4 miniatures, gabarit Canva (thumbnail-template)`"]
        M3 --> M4["`**L'équipe choisit la miniature**
(thumbnail --pick N)`"]
    end

    subgraph CA["Carrousel LinkedIn"]
        direction TB
        C1("`**carousel**
Claude propose 3 angles`") --> C2["`**L'équipe choisit 1 angle**
(carousel --pick N)`"]
        C2 --> C3("`**Slides rédigées par Claude**
citations vérifiées, CTA final`")
        C3 --> C3b("`**Description LinkedIn**
avec le lien de réservation`")
        C3b --> C4["`**Rendu PDF**
charte AI Partners`"]
        C4 --> CR("`**review**
relecteur Claude sans contexte`")
        CR -->|à corriger| C3
        CR -->|OK| C5["`**L'équipe valide**
(carousel --final STYLE)`"]
        C5 -->|retouche| C4
    end

    subgraph NL["Mail podcast de Thomas"]
        direction TB
        N1("`**newsletter**
Claude écrit le mail de Thomas`")
        N1 --> N2["`**Mail mis en page**
photo, miniature YouTube`"]
        N2 --> NR("`**review**
relecteur Claude sans contexte`")
        NR -->|à corriger| N1
        NR -->|OK| N3["`**L'équipe valide le mail**
(newsletter --final)`"]
        N3 -->|retouche| N2
    end

    S7 --> L1(["`**5 shorts et 5 posts LinkedIn**`"])

    M2 -.->|attend le titre| E5
    M4 -.->|attend la miniature| S7
    E9 --> L2(["`**Épisode 1080p**
teaser, chapitres, description`"])
    C5 --> L4(["`**Carrousel PDF**
et sa description LinkedIn`"])
    N3 --> L5(["`**Mail de Thomas**
prêt à envoyer`"])
    E5 -.->|chapitres| N1
    M4 -.->|miniature| N2
    M4 --> L3(["`**Titre et miniature**
1280×720 + HD`"])
    L1 & L2 & L3 & L4 & L5 --> LV(["`**livraison**
dossier LIVRABLES/ : versions finales
et état de chaque livrable, à copier sur le Drive`"])

